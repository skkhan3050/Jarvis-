# ==============================================================================
# JARVIS PERSONAL AI OPERATING SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and populate your active credentials.
# IMPORTANT: Never commit your real .env file or sensitive keys into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_LOG_LEVEL=INFO
# Optional master API key for securing Jarvis REST endpoints
JARVIS_API_KEY=

# ------------------------------------------------------------------------------
# 2. LOCAL & CLOUD LLM PROVIDERS
# ------------------------------------------------------------------------------
# Primary Local Ollama instance
OLLAMA_BASE_URL=http://127.0.0.1:11434
JARVIS_DEFAULT_MODEL=qwen:7b

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API (optional)
ANTHROPIC_API_KEY=

# OpenAI API (optional)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 3. VOICE, SPEECH & MULTILINGUAL (BENGALI, HINDI, ENGLISH)
# ------------------------------------------------------------------------------
# ElevenLabs Text-to-Speech API
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Speech Recognition & Synthesis language (en-US, bn-IN, hi-IN)
JARVIS_VOICE_LANG=bn-IN

# ------------------------------------------------------------------------------
# 4. n8n WORKFLOW AUTOMATION PLATFORM
# ------------------------------------------------------------------------------
# URL of your cloud VPS or hosted n8n instance (Must be HTTPS)
JARVIS_N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/jarvis-chat
JARVIS_N8N_TEST_WEBHOOK_URL=https://n8n.yourdomain.com/webhook-test/jarvis-chat

# Authentication token passed to n8n webhook headers (Bearer token)
JARVIS_N8N_API_KEY=your_n8n_secure_bearer_token_here
JARVIS_N8N_TIMEOUT_SECONDS=30.0
JARVIS_N8N_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 5. SUPABASE POSTGRESQL & VECTOR MEMORY
# ------------------------------------------------------------------------------
# Supabase project URL and API keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 6. SPECIALIST AGENT CREDENTIALS
# ------------------------------------------------------------------------------
# Meta Ads Specialist (JARVIS_02_META_ADS)
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1234567890

# Google Ads Specialist (JARVIS_03_GOOGLE_ADS)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=123-456-7890
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Deep Web Research (JARVIS_05_RESEARCH)
TAVILY_API_KEY=your_tavily_search_api_key_here

# Gmail Specialist (JARVIS_06_GMAIL)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 7. SECURITY & HUMAN APPROVAL GATEWAY
# ------------------------------------------------------------------------------
JARVIS_SECURITY_ENABLED=true
JARVIS_REQUIRE_APPROVAL_BUDGET=true
JARVIS_REQUIRE_APPROVAL_EMAILS=true
